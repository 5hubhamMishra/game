# apps/game-server
DATABASE_URL=postgres://between_words:between_words_dev@localhost:5432/between_words
FRONTEND_ORIGIN=http://localhost:3000
PORT=8787
# Shared secret between this service and apps/web's server-side BFF routes.
# Must match GAME_SERVER_SERVICE_TOKEN below exactly. Generate a real random
# value for anything beyond local dev -- this default is dev-only.
INTERNAL_SERVICE_TOKEN=dev-service-token

# apps/web
# Public: the browser connects its socket directly to this URL. Never used
# for the HTTP session/room calls below -- those go through apps/web's own
# same-origin /api routes, which forward server-to-server using the two
# GAME_SERVER_* vars instead.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:8787
GAME_SERVER_URL=http://localhost:8787
GAME_SERVER_SERVICE_TOKEN=dev-service-token
