{
  "name": "between-words",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "typecheck": "tsc -b && npm run typecheck -w apps/web",
    "lint": "npm run lint -w apps/web",
    "test": "vitest run",
    "content:validate": "tsx packages/content/src/validate.ts",
    "verify": "npm run typecheck && npm run lint && npm run content:validate && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
